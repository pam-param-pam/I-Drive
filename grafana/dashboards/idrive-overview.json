{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "title": "HTTP requests by method",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum by (method) (rate(django_http_requests_total_by_method_total[5m]))",
          "legendFormat": "{{method}}",
          "refId": "A"
        },
        {
          "expr": "sum by (method) (increase(django_http_requests_total_by_method_total[$__range]))",
          "instant": true,
          "legendFormat": "{{method}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "reqps"},
        "overrides": [
          {"matcher": {"id": "byFrameRefID", "options": "A"}, "properties": [{"id": "custom.hideFrom", "value": {"legend": true, "tooltip": false, "viz": false}}]},
          {"matcher": {"id": "byFrameRefID", "options": "B"}, "properties": [{"id": "unit", "value": "short"}, {"id": "decimals", "value": 0}, {"id": "custom.axisPlacement", "value": "hidden"}, {"id": "custom.hideFrom", "value": {"legend": false, "tooltip": true, "viz": true}}]}
        ]
      },
      "options": {"legend": {"calcs": ["sum"], "displayMode": "table", "placement": "bottom"}}
    },
    {
      "title": "HTTP responses by status",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum by (status) (rate(django_http_responses_total_by_status_total[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        },
        {
          "expr": "sum by (status) (increase(django_http_responses_total_by_status_total[$__range]))",
          "instant": true,
          "legendFormat": "{{status}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "reqps"},
        "overrides": [
          {"matcher": {"id": "byFrameRefID", "options": "A"}, "properties": [{"id": "custom.hideFrom", "value": {"legend": true, "tooltip": false, "viz": false}}]},
          {"matcher": {"id": "byFrameRefID", "options": "B"}, "properties": [{"id": "unit", "value": "short"}, {"id": "decimals", "value": 0}, {"id": "custom.axisPlacement", "value": "hidden"}, {"id": "custom.hideFrom", "value": {"legend": false, "tooltip": true, "viz": true}}]}
        ]
      },
      "options": {"legend": {"calcs": ["sum"], "displayMode": "table", "placement": "bottom"}}
    },
    {
      "title": "HTTP latency (p95)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(django_http_requests_latency_seconds_by_view_method_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "title": "Streamed bytes per second",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "rate(idrive_streamed_bytes_total[5m])",
          "legendFormat": "bytes/s",
          "refId": "A"
        },
        {
          "expr": "sum(increase(idrive_streamed_bytes_total[$__range]))",
          "instant": true,
          "legendFormat": "Streamed data",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "Bps"},
        "overrides": [
          {"matcher": {"id": "byFrameRefID", "options": "A"}, "properties": [{"id": "custom.hideFrom", "value": {"legend": true, "tooltip": false, "viz": false}}]},
          {"matcher": {"id": "byFrameRefID", "options": "B"}, "properties": [{"id": "unit", "value": "bytes"}, {"id": "decimals", "value": 0}, {"id": "custom.axisPlacement", "value": "hidden"}, {"id": "custom.hideFrom", "value": {"legend": false, "tooltip": true, "viz": true}}]}
        ]
      },
      "options": {"legend": {"calcs": ["sum"], "displayMode": "table", "placement": "bottom"}}
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["idrive"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "IDrive Overview",
  "uid": "idrive-overview",
  "version": 1
}
